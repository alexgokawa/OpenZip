{
  "name": "openzip",
  "private": true,
  "version": "1.1.0",
  "description": "Free WinRAR-style archive manager for Windows with SCS (ETS2/ATS) .scs support and a built-in code editor",
  "author": "alexgokawa",
  "license": "MIT",
  "homepage": "https://github.com/alexgokawa/OpenZip",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexgokawa/OpenZip.git"
  },
  "type": "module",
  "main": "electron.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:app": "npm run build && electron-builder --win",
    "dist:win": "npm run build && electron-builder --win",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:hashfs": "node scripts/hashfs-test.cjs",
    "electron:dev": "concurrently \"vite\" \"wait-on tcp:5173 && electron .\""
  },
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "adm-zip": "^0.6.1",
    "node-7z": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@monaco-editor/react": "^4.7.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.7",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "lucide-react": "^1.70.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.openzip.app",
    "productName": "OpenZip",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron.cjs",
      "scs-hashfs.cjs",
      "temp-cleanup.cjs",
      "app-settings.cjs",
      "docs/icon.ico",
      "docs/icon.png",
      "bin/**/*"
    ],
    "asarUnpack": [
      "bin/**/*",
      "docs/icon.ico",
      "docs/icon.png"
    ],
    "fileAssociations": [
      {
        "ext": "scs",
        "name": "SCS Archive",
        "description": "SCS HashFS game archive",
        "role": "Editor"
      },
      {
        "ext": "zip",
        "name": "ZIP Archive",
        "description": "ZIP archive",
        "role": "Editor"
      },
      {
        "ext": "rar",
        "name": "RAR Archive",
        "description": "RAR archive",
        "role": "Editor"
      },
      {
        "ext": "7z",
        "name": "7z Archive",
        "description": "7z archive",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "docs/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "OpenZip Setup ${version}.${ext}"
    },
    "portable": {
      "artifactName": "OpenZip Portable ${version}.${ext}"
    }
  }
}
